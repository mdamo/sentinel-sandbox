[Unit]
Description=Sentinel trusted execution service (local protected socket)
After=network.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel-sandbox/sentinel-poc
ExecStart=/usr/bin/python3.13 -m sentinel.execution_service --config /etc/sentinel/config.json --unix /run/sentinel/control.sock
RuntimeDirectory=sentinel
RuntimeDirectoryMode=0700
StateDirectory=sentinel
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/sentinel /run/sentinel
MemoryMax=512M
CPUQuota=100%
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
